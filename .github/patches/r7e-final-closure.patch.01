new file mode 100644
index 0000000000000000000000000000000000000000..cb755a726025c6b4caa14b022b7bcacdaec203db
--- /dev/null
+++ b/scripts/clean-generated.mjs
@@ -0,0 +1,20 @@
+import fs from 'node:fs';
+
+const generatedPaths = [
+  'dist',
+  '.astro',
+  '.r7e-tmp',
+  'public/assets/portrait',
+  'public/assets/js',
+  'public/artifacts',
+  'src/data/generated',
+];
+
+const removed = [];
+for (const target of generatedPaths) {
+  if (!fs.existsSync(target)) continue;
+  fs.rmSync(target, { recursive: true, force: true });
+  removed.push(target);
+}
+
+console.log(JSON.stringify({ removed, removedCount: removed.length }, null, 2));
