diff --git a/scripts/validate-links.mjs b/scripts/validate-links.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..9a3040caabaf0f4f4a0b1eb06ac7f6f7fea06587
--- /dev/null
+++ b/scripts/validate-links.mjs
@@ -0,0 +1,213 @@
+import crypto from 'node:crypto';
+import fs from 'node:fs';
+import path from 'node:path';
+
+const root = path.resolve(process.argv[2] ?? 'dist');
+const reportPath = path.resolve(process.argv[3] ?? '.r7e-tmp/link-validation.json');
+const canonicalOrigin = 'https://davidanderle.com';
+const canonicalHosts = new Set(['davidanderle.com', 'www.davidanderle.com']);
+const ignoredSchemes = new Set(['mailto:', 'tel:', 'data:', 'blob:', 'about:']);
+
+const toPosix = (value) => value.replaceAll(path.sep, '/');
+const sha256 = (value) => crypto.createHash('sha256').update(value).digest('hex');
+const decodeHtml = (value) => value
+  .replace(/&#x([0-9a-f]+);/gi, (_, code) => String.fromCodePoint(Number.parseInt(code, 16)))
+  .replace(/&#([0-9]+);/g, (_, code) => String.fromCodePoint(Number.parseInt(code, 10)))
+  .replace(/&amp;/gi, '&')
+  .replace(/&quot;/gi, '"')
+  .replace(/&apos;|&#39;/gi, "'")
+  .replace(/&lt;/gi, '<')
+  .replace(/&gt;/gi, '>');
+
+function walk(directory) {
+  const files = [];
+  for (const entry of fs.readdirSync(directory, { withFileTypes: true })) {
+    const full = path.join(directory, entry.name);
+    if (entry.isDirectory()) files.push(...walk(full));
+    else if (entry.isFile()) files.push(full);
+    else throw new Error(`Unsupported filesystem entry: ${full}`);
+  }
+  return files;
+}
+
+if (!fs.existsSync(root) || !fs.statSync(root).isDirectory()) {
+  console.error(`link validation root is not a directory: ${root}`);
+  process.exit(2);
+}
+
+const files = walk(root).sort((a, b) => toPosix(path.relative(root, a)).localeCompare(toPosix(path.relative(root, b))));
+const relativeFiles = new Set(files.map((file) => toPosix(path.relative(root, file))));
+const htmlFiles = files.filter((file) => file.endsWith('.html'));
+const textFiles = files.filter((file) => /\.(?:html|css|svg)$/i.test(file));
+const idsByHtml = new Map();
+
+function routeForHtml(relative) {
+  if (relative === 'index.html') return '/';
+  if (relative.endsWith('/index.html')) return `/${relative.slice(0, -'index.html'.length)}`;
+  return `/${relative}`;
+}
+
+function baseRouteForFile(relative) {
+  return relative.endsWith('.html') ? routeForHtml(relative) : `/${relative}`;
+}
+
+for (const file of htmlFiles) {
+  const relative = toPosix(path.relative(root, file));
+  const text = fs.readFileSync(file, 'utf8');
+  const ids = new Set();
