+if (jsAssets.length !== 1 || !/^assets\/js\/vce-sequence\.[a-f0-9]+\.js$/.test(jsAssets[0] ?? '')) findings.push({ code: 'JS_ASSET_SCOPE', jsAssets });
+
+const manifest = files.sort().map((file) => {
+  const bytes = fs.readFileSync(file);
+  return {
+    path: path.relative(root, file).replaceAll(path.sep, '/'),
+    bytes: bytes.length,
+    sha256: crypto.createHash('sha256').update(bytes).digest('hex')
+  };
+});
+const result = {
+  root,
+  fileCount: manifest.length,
+  totalBytes: manifest.reduce((n, file) => n + file.bytes, 0),
+  runtimeScripts,
+  executableScriptCount: executableScripts.length,
+  jsAssets,
+  findings,
+  manifest
+};
+fs.mkdirSync('.r7e-tmp', { recursive: true });
+fs.writeFileSync('.r7e-tmp/dist-inspection.json', JSON.stringify(result, null, 2));
+console.log(JSON.stringify({ fileCount: result.fileCount, totalBytes: result.totalBytes, executableScriptCount: result.executableScriptCount, jsAssetCount: result.jsAssets.length, findings: findings.length }, null, 2));
+process.exitCode = findings.length ? 1 : 0;
