+      if (!(element instanceof HTMLElement)) return null;
+      const rect = element.getBoundingClientRect();
+      const style = getComputedStyle(element);
+      const before = getComputedStyle(element, '::before');
+      const after = getComputedStyle(element, '::after');
+      return {
+        tag: element.tagName.toLowerCase(),
+        id: element.id,
+        className: element.getAttribute('class') ?? '',
+        clientWidth: element.clientWidth,
+        scrollWidth: element.scrollWidth,
+        offsetWidth: element.offsetWidth,
+        rect: { left: rect.left, right: rect.right, width: rect.width },
+        computed: {
+          display: style.display,
+          width: style.width,
+          inlineSize: style.inlineSize,
+          minWidth: style.minWidth,
+          maxWidth: style.maxWidth,
+          minInlineSize: style.minInlineSize,
+          maxInlineSize: style.maxInlineSize,
+          whiteSpace: style.whiteSpace,
+          overflowWrap: style.overflowWrap,
+          wordBreak: style.wordBreak,
+          textWrap: style.textWrap,
+          overflowX: style.overflowX,
+          marginInline: [style.marginInlineStart, style.marginInlineEnd],
+          paddingInline: [style.paddingInlineStart, style.paddingInlineEnd],
+          borderInline: [style.borderInlineStartWidth, style.borderInlineEndWidth],
+          position: style.position,
+          transform: style.transform,
+          fontFamily: style.fontFamily,
+          fontSize: style.fontSize,
+          lineHeight: style.lineHeight,
+          letterSpacing: style.letterSpacing,
+          gridTemplateColumns: style.gridTemplateColumns,
+          flex: style.flex
+        },
+        pseudo: {
+          before: { content: before.content, display: before.display, width: before.width, position: before.position, transform: before.transform },
+          after: { content: after.content, display: after.display, width: after.width, position: after.position, transform: after.transform }
+        }
+      };
+    };
+
+    const title = document.querySelector<HTMLElement>('.project-hero h1');
+    const textRanges: Array<{ text: string; left: number; right: number; width: number; rootRightExceedance: number }> = [];
+    if (title) {
+      const walker = document.createTreeWalker(title, NodeFilter.SHOW_TEXT);
+      for (let node = walker.nextNode(); node; node = walker.nextNode()) {
+        const value = node.nodeValue ?? '';
+        for (const match of value.matchAll(/\S+/gu)) {
+          const start = match.index ?? 0;
+          const range = document.createRange();
+          range.setStart(node, start);
+          range.setEnd(node, start + match[0].length);
+          const rect = range.getBoundingClientRect();
+          textRanges.push({
+            text: match[0],
+            left: rect.left,
+            right: rect.right,
+            width: rect.width,
+            rootRightExceedance: Math.max(0, rect.right - root.clientWidth)
+          });
+        }
+      }
+    }
+    textRanges.sort((a, b) => Math.max(b.rootRightExceedance, b.width) - Math.max(a.rootRightExceedance, a.width));
+
+    const ancestorChain = [];
+    for (let element: HTMLElement | null = title; element; element = element.parentElement) {
+      ancestorChain.push(box(element));
+      if (element === root) break;
+    }
+
+    const offenders = Array.from(document.querySelectorAll<HTMLElement>('body *'))
+      .map((element) => {
+        const rect = element.getBoundingClientRect();
+        const style = getComputedStyle(element);
+        return {
+          tag: element.tagName.toLowerCase(),
+          id: element.id,
+          className: element.getAttribute('class') ?? '',
+          clientWidth: element.clientWidth,
+          scrollWidth: element.scrollWidth,
+          left: rect.left,
+          right: rect.right,
+          width: rect.width,
+          rootRightExceedance: Math.max(0, rect.right - root.clientWidth),
+          overflowX: style.overflowX,
+          position: style.position,
+          transform: style.transform
+        };
+      })
+      .filter((row) => row.scrollWidth > row.clientWidth || row.rootRightExceedance > 0.5)
+      .sort((a, b) => Math.max(b.scrollWidth - b.clientWidth, b.rootRightExceedance) - Math.max(a.scrollWidth - a.clientWidth, a.rootRightExceedance))
+      .slice(0, 40);
+
+    return {
+      viewport: { innerWidth, innerHeight, devicePixelRatio },
+      root: { clientWidth: root.clientWidth, scrollWidth: root.scrollWidth, overflow: root.scrollWidth - root.clientWidth },
+      title: box(title),
+      facts: box(document.querySelector('.project-facts')),
+      widestTitleTokens: textRanges.slice(0, 20),
+      ancestorChain,
+      offenders
+    };
+  });
+}
+
+async function attachSnapshot(testInfo: TestInfo, name: string, value: unknown): Promise<void> {
+  await testInfo.attach(name, { body: Buffer.from(JSON.stringify(value, null, 2)), contentType: 'application/json' });
+}
 
