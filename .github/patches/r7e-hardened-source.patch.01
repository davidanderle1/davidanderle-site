 import { getCollection } from 'astro:content';
 
+const allowTestFixtures = process.env.R7E_ALLOW_TEST_FIXTURES === '1';
+const visibleRecord = (data: { visibility: string; indexability?: string; testFixture: boolean }) =>
+  data.visibility === 'public'
+  && (data.indexability === undefined || data.indexability === 'index')
+  && (!data.testFixture || allowTestFixtures);
+
 export async function getPublicWork() {
-  return (await getCollection('work', ({ data }) => data.visibility === 'public' && data.indexability === 'index' && !data.testFixture))
+  return (await getCollection('work', ({ data }) => visibleRecord(data)))
     .sort((a, b) => a.data.title.localeCompare(b.data.title, 'en'));
 }
 
 export async function getPublicWriting() {
-  return (await getCollection('writing', ({ data }) => data.visibility === 'public' && data.indexability === 'index' && !data.testFixture))
