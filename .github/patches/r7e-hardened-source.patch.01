diff --git a/scripts/verify-stress-lineage.mjs b/scripts/verify-stress-lineage.mjs
new file mode 100644
index 0000000..fd98714
--- /dev/null
+++ b/scripts/verify-stress-lineage.mjs
@@ -0,0 +1,124 @@
+import fs from 'node:fs';
+import path from 'node:path';
+import { parseMarkdownFile } from './lib/frontmatter.mjs';
+
+const stressRoot = path.resolve('.r7e-tmp/stress');
+const contentRoot = path.join(stressRoot, 'content', 'work');
+const distRoot = path.join(stressRoot, 'dist');
+const productionDist = path.resolve('dist');
+const inputManifestPath = path.join(stressRoot, 'input-manifest.json');
+
+const normalize = (value) => String(value).normalize('NFC').toLocaleLowerCase('en-US');
+const errors = [];
+const add = (code, message) => errors.push({ code, message });
+
+if (!fs.existsSync(inputManifestPath)) add('INPUT_MANIFEST', 'Missing stress input manifest');
+const manifest = fs.existsSync(inputManifestPath) ? JSON.parse(fs.readFileSync(inputManifestPath, 'utf8')) : { records: [] };
+const files = fs.existsSync(contentRoot)
+  ? fs.readdirSync(contentRoot).filter((name) => name.endsWith('.md')).sort()
+  : [];
+const allRecords = files.map((name) => ({ file: name, ...parseMarkdownFile(path.join(contentRoot, name)).data }));
+const records = allRecords.filter((record) => record.testFixture === true);
+const canonicalRecords = allRecords.filter((record) => record.testFixture !== true);
+
+if (manifest.designation !== 'TEST_ONLY_DO_NOT_DEPLOY') add('DESIGNATION', 'Stress input is not explicitly marked test-only');
+if (records.length !== 500) add('INPUT_COUNT', `Expected 500 synthetic test records, found ${records.length}`);
+if (canonicalRecords.length < 2) add('CANONICAL_BASELINE', `Expected canonical production work records to remain present in stress build, found ${canonicalRecords.length}`);
+
+const manifestRecords = Array.isArray(manifest.records) ? manifest.records : [];
+if (manifestRecords.length !== 500) add('MANIFEST_COUNT', `Expected 500 manifest records, found ${manifestRecords.length}`);
+const manifestById = new Map(manifestRecords.map((record) => [normalize(record.immutableId), record]));
+for (const record of records) {
+  const manifestRecord = manifestById.get(normalize(record.immutableId));
+  if (!manifestRecord) {
+    add('MANIFEST_BINDING', `${record.immutableId} missing from input manifest`);
+    continue;
+  }
+  if (manifestRecord.canonicalSlug !== record.canonicalSlug || manifestRecord.route !== record.route) {
+    add('MANIFEST_BINDING', `${record.immutableId} manifest slug/route mismatch`);
+  }
+}
+
+for (const [field, values] of [
+  ['immutableId', records.map((r) => r.immutableId)],
+  ['canonicalSlug', records.map((r) => r.canonicalSlug)],
+  ['route', records.map((r) => r.route)]
+]) {
+  const normalized = values.map(normalize);
+  if (new Set(normalized).size !== 500) add('NORMALIZED_UNIQUENESS', `${field} is not unique after NFC/case folding`);
+}
+
+for (const record of records) {
+  if (record.testFixture !== true) add('FIXTURE_FLAG', `${record.file} is not testFixture=true`);
+  const expectedRoute = `/work/${record.canonicalSlug}/`;
+  if (record.route !== expectedRoute) add('ROUTE_MAPPING', `${record.immutableId} route ${record.route} != ${expectedRoute}`);
+  const detail = path.join(distRoot, 'work', record.canonicalSlug, 'index.html');
+  if (!fs.existsSync(detail)) {
+    add('MISSING_DETAIL', `${record.immutableId} missing ${detail}`);
+    continue;
+  }
+  const html = fs.readFileSync(detail, 'utf8');
+  if (!html.includes(`https://stress.invalid${expectedRoute}`)) add('CANONICAL_DETAIL', `${record.immutableId} missing canonical stress route`);
+  if (!html.includes(record.title)) add('DETAIL_TITLE', `${record.immutableId} title missing from detail output`);
+}
+
+const details = fs.existsSync(path.join(distRoot, 'work'))
+  ? fs.readdirSync(path.join(distRoot, 'work'), { withFileTypes: true })
+      .filter((entry) => entry.isDirectory() && entry.name.startsWith('synthetic-test-record-'))
+      .map((entry) => entry.name)
+  : [];
+if (details.length !== 500 || new Set(details.map(normalize)).size !== 500) {
+  add('OUTPUT_BIJECTION', `Expected exactly 500 unique synthetic detail directories, found ${details.length}`);
+}
+
+for (const rel of ['work/index.html', 'archive/index.html']) {
+  const target = path.join(distRoot, rel);
+  if (!fs.existsSync(target)) {
+    add('COVERAGE_PAGE', `Missing ${rel}`);
+    continue;
+  }
+  const html = fs.readFileSync(target, 'utf8');
+  const linked = records.filter((record) => html.includes(`href="${record.route}"`)).length;
+  if (linked !== 500) add('COVERAGE_LINKS', `${rel} links ${linked}/500 synthetic records`);
+}
+
+const walkFiles = (dir) => fs.existsSync(dir)
+  ? fs.readdirSync(dir, { withFileTypes: true }).flatMap((entry) => entry.isDirectory()
+      ? walkFiles(path.join(dir, entry.name))
+      : [path.join(dir, entry.name)])
+  : [];
+const productionText = walkFiles(productionDist)
+  .filter((file) => /\.(?:html|xml|json|txt)$/i.test(file))
+  .map((file) => {
+    try { return fs.readFileSync(file, 'utf8'); } catch { return ''; }
+  }).join('\n');
+if (/synthetic-test-record-|Synthetic TEST WorkRecord|TEST fixture/i.test(productionText)) {
+  add('PRODUCTION_CONTAMINATION', 'Synthetic stress identity appears in production dist');
+}
+
+const packageJson = JSON.parse(fs.readFileSync('package.json', 'utf8'));
+if (!String(packageJson.scripts?.['test:stress:build'] ?? '').includes('astro build')) add('ASTRO_BUILD_PATH', 'Stress build command is not Astro build');
+const directWriters = fs.readdirSync('scripts').filter((name) => /stress/i.test(name)).filter((name) => {
+  const text = fs.readFileSync(path.join('scripts', name), 'utf8');
+  return /writeFileSync\([^\n]*\.html|writeFile\([^\n]*\.html/i.test(text);
+});
+if (directWriters.length) add('DIRECT_HTML_WRITER', `Stress scripts directly write HTML: ${directWriters.join(', ')}`);
+
+const result = {
+  designation: 'TEST_ONLY_DO_NOT_DEPLOY',
+  passed: errors.length === 0,
+  inputRecordCount: records.length,
+  totalWorkRecordCount: allRecords.length,
+  canonicalBaselineWorkRecords: canonicalRecords.length,
+  normalizedUniqueIds: new Set(records.map((r) => normalize(r.immutableId))).size,
+  normalizedUniqueSlugs: new Set(records.map((r) => normalize(r.canonicalSlug))).size,
+  normalizedUniqueRoutes: new Set(records.map((r) => normalize(r.route))).size,
+  emittedDetailPageCount: details.length,
+  workIndexCoverage: fs.existsSync(path.join(distRoot, 'work/index.html')) ? records.filter((r) => fs.readFileSync(path.join(distRoot, 'work/index.html'), 'utf8').includes(`href="${r.route}"`)).length : 0,
+  archiveCoverage: fs.existsSync(path.join(distRoot, 'archive/index.html')) ? records.filter((r) => fs.readFileSync(path.join(distRoot, 'archive/index.html'), 'utf8').includes(`href="${r.route}"`)).length : 0,
+  directHtmlWriters: directWriters,
+  errors
+};
+fs.writeFileSync(path.join(stressRoot, 'lineage.json'), JSON.stringify(result, null, 2) + '\n');
+console.log(JSON.stringify(result, null, 2));
+if (!result.passed) process.exitCode = 1;
