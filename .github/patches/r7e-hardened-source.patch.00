diff --git a/scripts/network-audit.mjs b/scripts/network-audit.mjs
index 8e5431c..56a2d17 100644
--- a/scripts/network-audit.mjs
+++ b/scripts/network-audit.mjs
@@ -1,43 +1,138 @@
+import crypto from 'node:crypto';
 import fs from 'node:fs';
+import net from 'node:net';
+import { once } from 'node:events';
 import { spawn } from 'node:child_process';
 import { chromium } from '@playwright/test';
 
 fs.mkdirSync('.r7e-tmp/network', { recursive: true });
-const server = spawn(process.execPath, ['scripts/serve-dist.mjs'], { stdio: ['ignore','pipe','pipe'] });
+const sha = (text) => crypto.createHash('sha256').update(text).digest('hex');
+async function freePort() {
+  const probe = net.createServer();
+  probe.listen(0, '127.0.0.1');
+  await once(probe, 'listening');
+  const address = probe.address();
+  if (!address || typeof address === 'string') throw new Error('Unable to reserve ephemeral port');
+  const port = address.port;
+  probe.close();
+  await once(probe, 'close');
+  return port;
+}
+const port = await freePort();
+const origin = `http://127.0.0.1:${port}`;
+const expectedHomeSha256 = sha(fs.readFileSync('dist/index.html', 'utf8'));
+const server = spawn(process.execPath, ['scripts/serve-dist.mjs'], {
+  stdio: ['ignore','pipe','pipe'],
+  env: { ...process.env, PORT: String(port), HOST: '127.0.0.1' }
+});
 let serverOut=''; let serverErr='';
 server.stdout.on('data', d => serverOut += d);
 server.stderr.on('data', d => serverErr += d);
 const sleep = ms => new Promise(r => setTimeout(r, ms));
+
+async function stopServer() {
+  if (server.exitCode !== null || server.signalCode !== null) return;
+  let exited = once(server, 'exit');
+  server.kill('SIGTERM');
+  await Promise.race([exited, sleep(2000)]);
+  if (server.exitCode === null && server.signalCode === null) {
+    exited = once(server, 'exit');
+    server.kill('SIGKILL');
+    await exited;
+  }
+}
+
 let ready=false;
+let servedHomeSha256=null;
 for (let i=0;i<100;i++) {
-  try { const r=await fetch('http://127.0.0.1:4173/'); if (r.ok) { ready=true; break; } } catch {}
+  try {
+    const response=await fetch(`${origin}/`);
+    if (response.ok) {
+      const text=await response.text();
+      servedHomeSha256=sha(text);
+      if (servedHomeSha256 !== expectedHomeSha256) throw new Error('Server is not serving the current dist/index.html');
+      ready=true;
+      break;
+    }
+  } catch {}
   await sleep(100);
 }
-if (!ready) { server.kill('SIGTERM'); console.error(serverOut); console.error(serverErr); throw new Error('Server not ready'); }
+if (!ready) {
+  await stopServer();
+  fs.writeFileSync('.r7e-tmp/network/server.stdout.txt', serverOut);
+  fs.writeFileSync('.r7e-tmp/network/server.stderr.txt', serverErr);
+  console.error(serverOut);
+  console.error(serverErr);
+  throw new Error('Server not ready with current dist identity');
+}
+
 const routes=['/','/work/','/archive/','/work/volatility-cascade-engine/','/about/'];
-const browser=await chromium.launch({headless:true});
+let browser = null;
 const rows=[];
+let auditError = null;
 try {
+  browser=await chromium.launch({headless:true});
   const context=await browser.newContext();
   for (const route of routes) {
     const page=await context.newPage();
     const requests=[];
-    page.on('request', req => requests.push({url:req.url(), resourceType:req.resourceType(), method:req.method()}));
-    await page.goto(`http://127.0.0.1:4173${route}`, {waitUntil:'networkidle'});
-    const classified=requests.map(r => {
-      const u=new URL(r.url);
-      const firstParty=(u.hostname==='127.0.0.1' || u.hostname==='localhost');
-      return {...r, origin:u.origin, firstParty};
+    const responses=[];
+    const requestFailures=[];
+    page.on('request', request => requests.push({url:request.url(), resourceType:request.resourceType(), method:request.method()}));
+    page.on('response', response => responses.push({url:response.url(), status:response.status()}));
+    page.on('requestfailed', request => requestFailures.push({url:request.url(), errorText:request.failure()?.errorText ?? 'unknown'}));
+    try {
+      await page.goto(`${origin}${route}`, {waitUntil:'networkidle'});
+    } catch (error) {
+      requestFailures.push({url:`${origin}${route}`, errorText:error instanceof Error ? error.message : String(error)});
+    }
+    const classified=requests.map(request => {
+      const url=new URL(request.url);
+      const firstParty=(url.hostname==='127.0.0.1' || url.hostname==='localhost');
+      return {...request, origin:url.origin, firstParty};
+    });
+    const classifiedResponses=responses.map(response => {
+      const url=new URL(response.url);
+      return {...response, firstParty:(url.hostname==='127.0.0.1' || url.hostname==='localhost')};
+    });
+    rows.push({
+      route,
+      requests:classified,
+      responses:classifiedResponses,
+      requestFailures,
+      thirdParty:classified.filter(request=>!request.firstParty),
+      firstPartyHttpErrors:classifiedResponses.filter(response=>response.firstParty && response.status>=400)
     });
-    rows.push({route, requests:classified, thirdParty:classified.filter(r=>!r.firstParty)});
     await page.close();
   }
+  await context.close();
+} catch (error) {
+  auditError = error instanceof Error ? { name:error.name, message:error.message, stack:error.stack } : { message:String(error) };
 } finally {
-  await browser.close();
-  server.kill('SIGTERM');
+  try {
+    if (browser) await browser.close();
+  } finally {
+    await stopServer();
+    fs.writeFileSync('.r7e-tmp/network/server.stdout.txt', serverOut);
+    fs.writeFileSync('.r7e-tmp/network/server.stderr.txt', serverErr);
+  }
 }
-const thirdParty=rows.flatMap(r=>r.thirdParty.map(x=>({...x,route:r.route})));
-const result={routes:rows.map(r=>({route:r.route,requestCount:r.requests.length,thirdPartyCount:r.thirdParty.length})),genuineThirdPartyRuntimeRequestCount:thirdParty.length,thirdParty};
+const thirdParty=rows.flatMap(row=>row.thirdParty.map(request=>({...request,route:row.route})));
+const firstPartyHttpErrors=rows.flatMap(row=>row.firstPartyHttpErrors.map(response=>({...response,route:row.route})));
+const requestFailures=rows.flatMap(row=>row.requestFailures.map(request=>({...request,route:row.route})));
+const result={
+  server: { port, expectedHomeSha256, servedHomeSha256 },
+  routes:rows.map(row=>({route:row.route,requestCount:row.requests.length,responseCount:row.responses.length,thirdPartyCount:row.thirdParty.length,firstPartyHttpErrorCount:row.firstPartyHttpErrors.length,requestFailureCount:row.requestFailures.length})),
+  expectedRoutes:routes.length,
+  auditedRoutes:rows.length,
+  genuineThirdPartyRuntimeRequestCount:thirdParty.length,
+  firstPartyHttpErrorCount:firstPartyHttpErrors.length,
+  requestFailureCount:requestFailures.length,
+  auditError,
+  thirdParty,
+  firstPartyHttpErrors,
+  requestFailures
+};
 fs.writeFileSync('.r7e-tmp/network/audit.json',JSON.stringify(result,null,2));
 console.log(JSON.stringify(result,null,2));
-if (thirdParty.length) process.exitCode=1;
+if (rows.length !== routes.length || auditError || thirdParty.length || firstPartyHttpErrors.length || requestFailures.length) process.exitCode=1;
